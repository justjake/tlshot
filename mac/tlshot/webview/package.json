{
  "name": "tldraw-vite-example",
  "private": true,
  "version": "0.0.0",
  "author": {
    "name": "tldraw GB Ltd.",
    "email": "hello@tldraw.com"
  },
  "homepage": "https://tldraw.dev",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "swift": "quicktype -o ../tlshot/BridgeTypes.swift --src src/BridgeTypes.ts --protocol hashable --no-initializers --density dense",
    "swift:watch": "npm-watch swift",
    "preview": "vite preview"
  },
  "watch": {
    "swift": {
      "patterns": [
        "src/BridgeTypes.ts"
      ],
      "runOnChange": [
        "swift"
      ]
    }
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tldraw": "2.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "npm-watch": "0.13.0",
    "prettier": "3.3.3",
    "quicktype": "23.0.170",
    "typescript": "^5.0.2",
    "vite": "^5.2.11"
  }
}
